diff --git a/src/app/(app)/leave/emails/actions.ts b/src/app/(app)/leave/emails/actions.ts
new file mode 100644
index 0000000..e835010
--- /dev/null
+++ b/src/app/(app)/leave/emails/actions.ts
@@ -0,0 +1,43 @@
+'use server';
+
+import { revalidatePath } from 'next/cache';
+import { and, eq } from 'drizzle-orm';
+import { db, emailTemplate } from '@/db';
+import { done, fail, type ActionResult } from '@/lib/action-result';
+import { audit } from '@/lib/audit';
+import { assertCan } from '@/lib/auth/can';
+import { text } from '@/lib/form';
+import { EMAIL_KINDS, templateProblems, type EmailKind } from '@/lib/mail/custom';
+import { getActor } from '@/lib/session';
+import { companyIdOf } from '@/lib/tenant/scope';
+
+/** Saves one email's wording. Both boxes blank puts the built-in wording back. */
+export async function saveEmailTemplateAction(_p: ActionResult | null, fd: FormData): Promise<ActionResult> {
+  const actor = await getActor();
+  assertCan(actor, 'leavePolicy:manage', { companyId: actor?.companyId });
+  const companyId = companyIdOf(actor);
+
+  const kind = text(fd, 'kind');
+  if (!(kind in EMAIL_KINDS)) return fail('Unknown email.');
+  const k = kind as EmailKind;
+  const subject = text(fd, 'subject');
+  const body = typeof fd.get('body') === 'string' ? (fd.get('body') as string).replace(/\r\n/g, '\n').trim() : '';
+
+  if (subject === '' && body === '') {
+    await db.delete(emailTemplate).where(and(eq(emailTemplate.companyId, companyId), eq(emailTemplate.kind, k)));
+    await audit({ companyId, userId: actor.id, action: 'email.template.reset', entity: 'EmailTemplate', entityId: k });
+    revalidatePath('/leave/emails');
+    return done('Back to the standard wording.');
+  }
+
+  const problems = templateProblems(k, { subject, body });
+  if (problems.length) return fail(problems[0]);
+
+  await db
+    .insert(emailTemplate)
+    .values({ companyId, kind: k, subject, body })
+    .onConflictDoUpdate({ target: [emailTemplate.companyId, emailTemplate.kind], set: { subject, body } });
+  await audit({ companyId, userId: actor.id, action: 'email.template.save', entity: 'EmailTemplate', entityId: k });
+  revalidatePath('/leave/emails');
+  return done('Email wording saved. It applies to emails sent from now on.');
+}
diff --git a/src/app/(app)/leave/emails/page.tsx b/src/app/(app)/leave/emails/page.tsx
new file mode 100644
index 0000000..e823b4c
--- /dev/null
+++ b/src/app/(app)/leave/emails/page.tsx
@@ -0,0 +1,49 @@
+import { ActionForm, Field } from '@/components/action-form';
+import { PageHeader } from '@/components/shell/app-shell';
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
+import { Input } from '@/components/ui/input';
+import { Textarea } from '@/components/ui/textarea';
+import { EMAIL_KINDS, type EmailKind } from '@/lib/mail/custom';
+import { templateFor } from '@/lib/mail/store';
+import { requireCompanyActor } from '@/lib/session';
+import { saveEmailTemplateAction } from './actions';
+
+export const metadata = { title: 'Leave emails' };
+
+export default async function LeaveEmailsPage() {
+  const actor = await requireCompanyActor('leavePolicy:manage');
+  const kinds = Object.keys(EMAIL_KINDS) as EmailKind[];
+  const current = await Promise.all(kinds.map((k) => templateFor(actor.companyId, k)));
+
+  return (
+    <>
+      <PageHeader
+        title="Leave emails"
+        description="Change the wording of the emails people get about leave. Clear both boxes to go back to the standard text."
+      />
+      <div className="grid max-w-3xl gap-6">
+        {kinds.map((k, i) => (
+          <Card key={k}>
+            <CardHeader>
+              <CardTitle className="text-base">{EMAIL_KINDS[k].label}</CardTitle>
+              <p className="text-xs text-gray-500">
+                Placeholders: {EMAIL_KINDS[k].placeholders.map((p) => `{{${p}}}`).join('  ')}
+              </p>
+            </CardHeader>
+            <CardContent>
+              <ActionForm action={saveEmailTemplateAction} submitLabel="Save wording">
+                <input type="hidden" name="kind" value={k} />
+                <Field label="Subject" htmlFor={`${k}-subject`}>
+                  <Input id={`${k}-subject`} name="subject" defaultValue={current[i].subject} maxLength={150} />
+                </Field>
+                <Field label="Email text" htmlFor={`${k}-body`}>
+                  <Textarea id={`${k}-body`} name="body" defaultValue={current[i].body} rows={8} maxLength={3000} />
+                </Field>
+              </ActionForm>
+            </CardContent>
+          </Card>
+        ))}
+      </div>
+    </>
+  );
+}
