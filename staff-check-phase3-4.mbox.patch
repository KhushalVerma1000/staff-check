+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { payableTotal, payoutRow, safeText } from './payout';
+
+const ok = { status: 'APPROVED', bankHolder: 'Asha Rao', bankName: 'HDFC', account: '123456789012', ifsc: 'hdfc0001234' };
+
+test('a row with approved onboarding and full bank details is ready, IFSC upper-cased', () => {
+  const r = payoutRow({ code: 'E1', name: 'Asha', netPaise: 2_500_000 }, ok);
+  assert.equal(r.problem, '');
+  assert.equal(r.ifsc, 'HDFC0001234');
+});
+
+test('rows are held back with a reason, never silently paid', () => {
+  const s = { code: 'E', name: 'N', netPaise: 100 };
+  assert.match(payoutRow(s, undefined).problem, /No onboarding/);
+  assert.match(payoutRow(s, { ...ok, status: 'SUBMITTED' }).problem, /not approved/);
+  assert.match(payoutRow(s, { ...ok, account: null }).problem, /missing/);
+  assert.match(payoutRow(s, { ...ok, ifsc: 'BAD' }).problem, /IFSC/);
+  assert.match(payoutRow({ ...s, netPaise: 0 }, ok).problem, /Nothing to pay/);
+});
+
+test('the payable total counts only ready rows', () => {
+  const rows = [
+    payoutRow({ code: 'A', name: 'A', netPaise: 100_00 }, ok),
+    payoutRow({ code: 'B', name: 'B', netPaise: 200_00 }, undefined),
+    payoutRow({ code: 'C', name: 'C', netPaise: 50_00 }, ok),
+  ];
+  assert.equal(payableTotal(rows), 150_00);
+});
+
+test('formula-looking text is neutralised', () => {
+  assert.equal(safeText('=SUM(A1)'), "'=SUM(A1)");
+  assert.equal(safeText('Asha'), 'Asha');
+});
diff --git a/src/lib/payroll/payout.ts b/src/lib/payroll/payout.ts
new file mode 100644
index 0000000..ecb7f02
--- /dev/null
+++ b/src/lib/payroll/payout.ts
@@ -0,0 +1,52 @@
+export interface PayoutKyc {
+  status: string;
+  bankHolder: string | null;
+  bankName: string | null;
+  /** Already decrypted, or null when missing or undecryptable. */
+  account: string | null;
+  ifsc: string | null;
+}
+
+export interface PayoutRow {
+  code: string;
+  name: string;
+  holder: string;
+  bank: string;
+  account: string;
+  ifsc: string;
+  netPaise: number;
+  /** Empty when the row is ready to pay. Otherwise says why the bank must not be sent this row. */
+  problem: string;
+}
+
+/**
+ * One row per payslip for the bank upload. A row is only "ready" with approved onboarding, full bank details
+ * and something to pay; anything else is listed with the reason and left out of the payable total.
+ */
+export function payoutRow(slip: { code: string; name: string; netPaise: number }, kyc: PayoutKyc | undefined): PayoutRow {
+  const base = { code: slip.code, name: slip.name, netPaise: slip.netPaise };
+  const blank = { holder: '', bank: '', account: '', ifsc: '' };
+  if (!kyc) return { ...base, ...blank, problem: 'No onboarding record' };
+  const filled = {
+    holder: kyc.bankHolder ?? '',
+    bank: kyc.bankName ?? '',
+    account: kyc.account ?? '',
+    ifsc: (kyc.ifsc ?? '').toUpperCase(),
+  };
+  let problem = '';
+  if (kyc.status !== 'APPROVED') problem = 'Onboarding not approved yet';
+  else if (!filled.holder || !filled.account || !filled.ifsc) problem = 'Bank details missing';
+  else if (!/^[A-Z]{4}0[A-Z0-9]{6}$/.test(filled.ifsc)) problem = 'IFSC looks wrong';
+  else if (slip.netPaise <= 0) problem = 'Nothing to pay';
+  return { ...base, ...filled, problem };
+}
+
+/** Sum of net pay for rows ready to pay. */
+export function payableTotal(rows: PayoutRow[]): number {
+  return rows.filter((r) => !r.problem).reduce((a, r) => a + r.netPaise, 0);
+}
+
+/** Cells starting with = + - @ are text to Excel only if stored as text; this also keeps CSV/other readers from treating them as formulas. */
+export function safeText(v: string): string {
+  return /^[=+\-@\t\r]/.test(v) ? `'${v}` : v;
+}
diff --git a/src/lib/payroll/run.ts b/src/lib/payroll/run.ts
new file mode 100644
