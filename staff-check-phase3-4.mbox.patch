+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { allowances, balance, DEFAULT_ALLOWANCE, fits, yearBounds } from './balance';
+
+test('company policy rows override the defaults, other types keep them', () => {
+  const a = allowances([{ type: 'CASUAL', annualDays: 8 }, { type: 'PAID', annualDays: null }]);
+  assert.equal(a.CASUAL, 8);
+  assert.equal(a.PAID, null);
+  assert.equal(a.SICK, DEFAULT_ALLOWANCE.SICK);
+});
+
+test('remaining counts approved and pending days and never goes negative', () => {
+  assert.deepEqual(balance(12, 5, 2), { allowance: 12, used: 5, pending: 2, remaining: 5 });
+  assert.equal(balance(12, 10, 4).remaining, 0);
+  assert.equal(balance(null, 40, 3).remaining, null);
+});
+
+test('fits allows exactly the remaining days, half days included', () => {
+  const b = balance(12, 11, 0);
+  assert.equal(fits(b, 1), true);
+  assert.equal(fits(b, 1.5), false);
+  assert.equal(fits(balance(12, 11.5, 0), 0.5), true);
+  assert.equal(fits(balance(null, 999, 0), 30), true);
+});
+
+test('yearBounds spans 1 Jan to 31 Dec', () => {
+  const { from, to } = yearBounds(2026);
+  assert.equal(from.toISOString().slice(0, 10), '2026-01-01');
+  assert.equal(to.toISOString().slice(0, 10), '2026-12-31');
+});
diff --git a/src/lib/leave/balance.ts b/src/lib/leave/balance.ts
new file mode 100644
index 0000000..47baa40
--- /dev/null
+++ b/src/lib/leave/balance.ts
@@ -0,0 +1,51 @@
+import type { LeaveType } from '@/db/schema/app';
+
+/**
+ * Yearly allowance used when a company has not set its own policy row.
+ * null = unlimited. These are starting points only; HR / admin edit them per company.
+ */
+export const DEFAULT_ALLOWANCE: Record<LeaveType, number | null> = {
+  CASUAL: 12,
+  SICK: 12,
+  PAID: 15,
+  UNPAID: null,
+};
+
+export const LEAVE_TYPES = ['CASUAL', 'SICK', 'PAID', 'UNPAID'] as const satisfies readonly LeaveType[];
+
+/** Company policy rows layered over the defaults. */
+export function allowances(rows: Array<{ type: LeaveType; annualDays: number | null }>): Record<LeaveType, number | null> {
+  const out = { ...DEFAULT_ALLOWANCE };
+  for (const r of rows) out[r.type] = r.annualDays;
+  return out;
+}
+
+/** Calendar-year bounds (UTC dates, inclusive). A request counts toward the year its first day falls in. */
+export function yearBounds(year: number): { from: Date; to: Date } {
+  return { from: new Date(Date.UTC(year, 0, 1)), to: new Date(Date.UTC(year, 11, 31)) };
+}
+
+export interface Balance {
+  /** null = unlimited */
+  allowance: number | null;
+  used: number;
+  pending: number;
+  /** Days still free after approved and pending requests; null = unlimited. */
+  remaining: number | null;
+}
+
+export function balance(allowance: number | null, used: number, pending: number): Balance {
+  return {
+    allowance,
+    used,
+    pending,
+    remaining: allowance === null ? null : Math.max(0, round(allowance - used - pending)),
+  };
+}
+
+/** Would `days` more fit inside the allowance, counting approved and pending days already taken? */
+export function fits(b: Balance, days: number): boolean {
+  return b.remaining === null || days <= b.remaining + 1e-9;
+}
+
+const round = (n: number) => Math.round(n * 100) / 100;
diff --git a/src/lib/leave/queries.ts b/src/lib/leave/queries.ts
new file mode 100644
index 0000000..80461a6
--- /dev/null
+++ b/src/lib/leave/queries.ts
@@ -0,0 +1,32 @@
+import { and, eq, gte, lte, sql } from 'drizzle-orm';
+import { db, leavePolicy, leaveRequest } from '@/db';
+import type { LeaveType } from '@/db/schema/app';
+import { allowances, balance, LEAVE_TYPES, yearBounds, type Balance } from './balance';
+
+/** The company's yearly allowance per leave type (its policy rows over the defaults). */
+export async function companyAllowances(companyId: string): Promise<Record<LeaveType, number | null>> {
+  const rows = await db.select({ type: leavePolicy.type, annualDays: leavePolicy.annualDays }).from(leavePolicy).where(eq(leavePolicy.companyId, companyId));
+  return allowances(rows);
+}
+
+/** One employee's balance per leave type for a calendar year (requests count toward the year they start in). */
+export async function employeeBalances(companyId: string, employeeId: string, year: number): Promise<Record<LeaveType, Balance>> {
+  const { from, to } = yearBounds(year);
+  const [allowance, rows] = await Promise.all([
+    companyAllowances(companyId),
+    db
+      .select({ type: leaveRequest.type, status: leaveRequest.status, days: sql<number>`coalesce(sum(${leaveRequest.days}), 0)`.mapWith(Number) })
+      .from(leaveRequest)
+      .where(
+        and(
+          eq(leaveRequest.companyId, companyId),
+          eq(leaveRequest.employeeId, employeeId),
+          gte(leaveRequest.fromDate, from),
+          lte(leaveRequest.fromDate, to),
+        ),
+      )
+      .groupBy(leaveRequest.type, leaveRequest.status),
+  ]);
+  const used = (t: LeaveType, s: string) => rows.find((r) => r.type === t && r.status === s)?.days ?? 0;
+  return Object.fromEntries(LEAVE_TYPES.map((t) => [t, balance(allowance[t], used(t, 'APPROVED'), used(t, 'PENDING'))])) as Record<LeaveType, Balance>;
+}
