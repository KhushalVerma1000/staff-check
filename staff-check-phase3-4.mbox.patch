@@ -0,0 +1,18 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { channelsFor, NOTIFY_KINDS } from './prefs';
+
+test('channels default to both on', () => {
+  assert.deepEqual(channelsFor([], 'leave.decided'), { inApp: true, email: true });
+});
+
+test('a saved preference applies only to its own event', () => {
+  const prefs = [{ kind: 'leave.requested', inApp: true, email: false }];
+  assert.deepEqual(channelsFor(prefs, 'leave.requested'), { inApp: true, email: false });
+  assert.deepEqual(channelsFor(prefs, 'leave.decided'), { inApp: true, email: true });
+});
+
+test('event kinds are unique', () => {
+  const kinds = NOTIFY_KINDS.map((k) => k.kind);
+  assert.equal(new Set(kinds).size, kinds.length);
+});
diff --git a/src/lib/notify/prefs.ts b/src/lib/notify/prefs.ts
new file mode 100644
index 0000000..6b2027e
--- /dev/null
+++ b/src/lib/notify/prefs.ts
@@ -0,0 +1,18 @@
+/** Events a person can tune. Adding an event kind to notify() means adding it here too. */
+export const NOTIFY_KINDS = [
+  { kind: 'leave.requested', label: 'A colleague asks for leave', hint: 'Sent to whoever decides it.' },
+  { kind: 'leave.decided', label: 'My leave is approved or rejected', hint: 'Sent to the person who asked.' },
+] as const;
+
+export type NotifyKind = (typeof NOTIFY_KINDS)[number]['kind'];
+
+export interface Channels {
+  inApp: boolean;
+  email: boolean;
+}
+
+/** A person's channels for an event; both on unless they turned one off. */
+export function channelsFor(prefs: Array<{ kind: string; inApp: boolean; email: boolean }>, kind: string): Channels {
+  const p = prefs.find((x) => x.kind === kind);
+  return p ? { inApp: p.inApp, email: p.email } : { inApp: true, email: true };
+}
