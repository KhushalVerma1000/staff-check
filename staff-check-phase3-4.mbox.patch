diff --git a/src/app/(app)/notifications/settings/actions.ts b/src/app/(app)/notifications/settings/actions.ts
new file mode 100644
index 0000000..144fc87
--- /dev/null
+++ b/src/app/(app)/notifications/settings/actions.ts
@@ -0,0 +1,27 @@
+'use server';
+
+import { revalidatePath } from 'next/cache';
+import { db, notificationPref } from '@/db';
+import { done, type ActionResult } from '@/lib/action-result';
+import { NOTIFY_KINDS } from '@/lib/notify/prefs';
+import { getActor } from '@/lib/session';
+
+/** Saves the signed-in person's own channel choices; never anyone else's. */
+export async function saveNotificationPrefsAction(_p: ActionResult | null, fd: FormData): Promise<ActionResult> {
+  const actor = await getActor();
+  if (!actor?.companyId) return { ok: false, error: 'Sign in again to change your notifications.' };
+  const companyId = actor.companyId;
+
+  await db.transaction(async (tx) => {
+    for (const { kind } of NOTIFY_KINDS) {
+      const inApp = fd.get(`${kind}:inApp`) === 'on';
+      const email = fd.get(`${kind}:email`) === 'on';
+      await tx
+        .insert(notificationPref)
+        .values({ companyId, userId: actor.id, kind, inApp, email })
+        .onConflictDoUpdate({ target: [notificationPref.userId, notificationPref.kind], set: { inApp, email } });
+    }
+  });
+  revalidatePath('/notifications/settings');
+  return done('Notification settings saved.');
+}
diff --git a/src/app/(app)/notifications/settings/page.tsx b/src/app/(app)/notifications/settings/page.tsx
new file mode 100644
index 0000000..412c76e
--- /dev/null
+++ b/src/app/(app)/notifications/settings/page.tsx
@@ -0,0 +1,55 @@
+import { eq } from 'drizzle-orm';
+import { ActionForm } from '@/components/action-form';
+import { PageHeader } from '@/components/shell/app-shell';
+import { Card, CardContent } from '@/components/ui/card';
+import { db, notificationPref } from '@/db';
+import { channelsFor, NOTIFY_KINDS } from '@/lib/notify/prefs';
+import { requireCompanyActor } from '@/lib/session';
+import { saveNotificationPrefsAction } from './actions';
+
+export const metadata = { title: 'Notification settings' };
+
+export default async function NotificationSettingsPage() {
+  const actor = await requireCompanyActor();
+  const prefs = await db.select().from(notificationPref).where(eq(notificationPref.userId, actor.id));
+
+  return (
+    <>
+      <PageHeader title="Notification settings" description="Choose how you hear about each event." />
+      <Card className="max-w-2xl">
+        <CardContent className="p-4">
+          <ActionForm action={saveNotificationPrefsAction} submitLabel="Save settings">
+            <table className="w-full text-sm">
+              <thead>
+                <tr className="text-left text-xs uppercase tracking-wide text-gray-500">
+                  <th className="py-2 font-medium">Event</th>
+                  <th className="w-20 py-2 text-center font-medium">In app</th>
+                  <th className="w-20 py-2 text-center font-medium">Email</th>
+                </tr>
+              </thead>
+              <tbody className="divide-y">
+                {NOTIFY_KINDS.map((k) => {
+                  const ch = channelsFor(prefs, k.kind);
+                  return (
+                    <tr key={k.kind}>
+                      <td className="py-3 pr-4">
+                        <p className="font-medium text-gray-900">{k.label}</p>
+                        <p className="text-xs text-gray-500">{k.hint}</p>
+                      </td>
+                      <td className="text-center">
+                        <input type="checkbox" name={`${k.kind}:inApp`} defaultChecked={ch.inApp} aria-label={`${k.label}: in app`} className="h-5 w-5" />
+                      </td>
+                      <td className="text-center">
+                        <input type="checkbox" name={`${k.kind}:email`} defaultChecked={ch.email} aria-label={`${k.label}: email`} className="h-5 w-5" />
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          </ActionForm>
+        </CardContent>
+      </Card>
+    </>
+  );
+}
